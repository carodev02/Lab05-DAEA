<Window x:Class="Semana04_XS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeptunoDB · Laboratorio 04" Height="820" Width="1280" MinHeight="650" MinWidth="960" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="NeptunoDB" FontSize="28" FontWeight="Bold"/><TextBlock Text="WPF · MVVM · ADO.NET · Procedimientos almacenados" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            <Button Grid.Column="1" Content="Actualizar todo" Command="{Binding CargarTodoCommand}" VerticalAlignment="Center"/>
        </Grid>
        <TabControl Grid.Row="1">
            <TabItem Header="Productos"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedProducto.NombreProducto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nombre del producto"/><TextBox Grid.Column="1" Text="{Binding SelectedProducto.ProveedorID}" ToolTip="Proveedor ID"/><TextBox Grid.Column="2" Text="{Binding SelectedProducto.CategoriaID}" ToolTip="Categoría ID"/><TextBox Grid.Column="3" Text="{Binding SelectedProducto.CantidadPorUnidad}" ToolTip="Cantidad por unidad"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedProducto.PrecioUnidad}" ToolTip="Precio"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProducto.UnidadesEnExistencia}" ToolTip="Existencia"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedProducto.UnidadesEnPedido}" ToolTip="En pedido"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedProducto.NivelDeReorden}" ToolTip="Nivel de reorden"/>
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal"><CheckBox IsChecked="{Binding SelectedProducto.Descontinuado}" VerticalAlignment="Center"/><TextBlock Text="Descontinuado" Margin="8,0" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nuevo" Command="{Binding NuevoProductoCommand}"/><Button Content="Guardar" Command="{Binding GuardarProductoCommand}"/><Button Style="{StaticResource DangerButton}" Content="Eliminar" Command="{Binding EliminarProductoCommand}"/></StackPanel>
                </Grid></Border><DataGrid Grid.Row="1" ItemsSource="{Binding Productos}" SelectedItem="{Binding SelectedProducto}"/>
            </Grid></TabItem>
            <TabItem Header="Categorías"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedCategoria.NombreCategoria, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nombre"/><TextBox Grid.Column="1" Text="{Binding SelectedCategoria.Descripcion}" ToolTip="Descripción"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="Nuevo" Command="{Binding NuevaCategoriaCommand}"/><Button Content="Guardar" Command="{Binding GuardarCategoriaCommand}"/><Button Style="{StaticResource DangerButton}" Content="Eliminar" Command="{Binding EliminarCategoriaCommand}"/></StackPanel>
                </Grid></Border><DataGrid Grid.Row="1" ItemsSource="{Binding Categorias}" SelectedItem="{Binding SelectedCategoria}"/>
            </Grid></TabItem>
            <TabItem Header="Proveedores"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedProveedor.CompaniaNombre}" ToolTip="Compañía"/><TextBox Grid.Column="1" Text="{Binding SelectedProveedor.NombreContacto}" ToolTip="Contacto"/><TextBox Grid.Column="2" Text="{Binding SelectedProveedor.CargoContacto}" ToolTip="Cargo"/><TextBox Grid.Column="3" Text="{Binding SelectedProveedor.Direccion}" ToolTip="Dirección"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedProveedor.Ciudad}" ToolTip="Ciudad"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProveedor.Pais}" ToolTip="País"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedProveedor.Telefono}" ToolTip="Teléfono"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedProveedor.Fax}" ToolTip="Fax"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding SelectedProveedor.CodigoPostal}" ToolTip="Código postal"/>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nuevo" Command="{Binding NuevoProveedorCommand}"/><Button Content="Guardar" Command="{Binding GuardarProveedorCommand}"/><Button Style="{StaticResource DangerButton}" Content="Eliminar" Command="{Binding EliminarProveedorCommand}"/></StackPanel>
                </Grid></Border><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"><TextBox Width="240" Text="{Binding FiltroContacto}" ToolTip="Filtrar por contacto"/><TextBox Width="200" Text="{Binding FiltroCiudad}" ToolTip="Filtrar por ciudad"/><Button Content="Buscar" Command="{Binding BuscarProveedoresCommand}"/></StackPanel><DataGrid Grid.Row="2" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding SelectedProveedor}"/>
            </Grid></TabItem>
            <TabItem Header="Pedidos"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SelectedPedido.ClienteID}" ToolTip="Cliente ID"/><TextBox Grid.Column="1" Text="{Binding SelectedPedido.EmpleadoID}" ToolTip="Empleado ID"/><DatePicker Grid.Column="2" SelectedDate="{Binding SelectedPedido.FechaPedido}" ToolTip="Fecha pedido"/><DatePicker Grid.Column="3" SelectedDate="{Binding SelectedPedido.FechaRequerida}" ToolTip="Fecha requerida"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding SelectedPedido.TransportistaID}" ToolTip="Transportista ID"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPedido.Destinatario}" ToolTip="Destinatario"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SelectedPedido.CiudadDestino}" ToolTip="Ciudad destino"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedPedido.PaisDestino}" ToolTip="País destino"/>
                    <DatePicker Grid.Row="2" Grid.Column="0" SelectedDate="{Binding SelectedPedido.FechaEnvio}" ToolTip="Fecha de envío"/>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nuevo" Command="{Binding NuevoPedidoCommand}"/><Button Content="Guardar" Command="{Binding GuardarPedidoCommand}"/><Button Style="{StaticResource DangerButton}" Content="Eliminar" Command="{Binding EliminarPedidoCommand}"/></StackPanel>
                </Grid></Border><DataGrid Grid.Row="1" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding SelectedPedido}"/>
            </Grid></TabItem>
            <TabItem Header="Reporte por fechas"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Label Content="Desde"/><DatePicker SelectedDate="{Binding FechaDesde}"/><Label Content="Hasta"/><DatePicker SelectedDate="{Binding FechaHasta}"/><Button Content="Generar reporte" Command="{Binding GenerarReporteCommand}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Reporte}"/>
            </Grid></TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0"><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"/></Border>
    </Grid>
</Window>
